{
  "name": "botkeep-console",
  "private": true,
  "version": "1.0.0",
  "description": "Developer console and API portal for the Botkeep hosting API (api.botkeep.cloud).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite build && node server/index.mjs",
    "typecheck": "tsc -b --noEmit",
    "generate:endpoints": "node scripts/generate-endpoints.mjs",
    "verify:preview": "node scripts/verify-preview.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "framer-motion": "^12.4.2",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
